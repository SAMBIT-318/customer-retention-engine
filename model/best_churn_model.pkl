import pandas as pd
from sklearn.ensemble import RandomForestClassifier
import joblib

# 1. Load your training data
# df = pd.read_csv('your_churn_data.csv')
# X = df.drop('Churn', axis=1)
# y = df['Churn']

# 2. Train the model (using dummy data here as an example)
X = [[1, 2], [3, 4], [5, 6], [7, 8]]
y = [0, 0, 1, 1]

model = RandomForestClassifier()
model.fit(X, y)

# 3. Save the trained model properly
# This creates the REAL binary .pkl file
joblib.dump(model, 'best_churn_model.pkl')
print("Model saved successfully!")
