import pandas as pd
from sklearn.ensemble import RandomForestClassifier
import joblib

# 1. Create sample training data
data = {
    'tenure': [1, 24, 72, 12, 60, 4, 36, 70],
    'MonthlyCharges': [29.85, 56.95, 105.65, 42.30, 89.10, 74.40, 55.20, 110.50],
    'Contract': [0, 1, 2, 0, 2, 0, 1, 2],
    'TechSupport': [0, 1, 1, 0, 1, 0, 1, 1],
    'Churn': [1, 0, 0, 1, 0, 1, 0, 0] 
}

df = pd.DataFrame(data)

# 2. Separate features (X) and target (y)
X = df.drop('Churn', axis=1)
y = df['Churn']

# 3. Train the model
model = RandomForestClassifier(random_state=42)
model.fit(X, y)

# 4. Save the real binary model
joblib.dump(model, "best_churn_model.pkl")

# 5. Automatically download the file to your computer
from google.colab import files
files.download("best_churn_model.pkl")
